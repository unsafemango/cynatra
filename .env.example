# Used by docker-compose. Get a key at https://www.themoviedb.org/settings/api
# (either the v3 API key or the v4 read access token works).
TMDB_API_KEY=
JWT_SECRET=change-me-to-a-long-random-string
# Optional: "Sign in with Google" OAuth client ID (Google Cloud Console →
# Credentials → OAuth client ID → Web application). Empty hides the button.
GOOGLE_CLIENT_ID=
# Email for sign-up codes. Empty SMTP_HOST: codes go to the local Mailpit inbox
# (http://localhost:8025). For real delivery, e.g. Brevo (Settings → SMTP & API → SMTP):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a sender address you've verified with your provider.
EMAIL_FROM=Cynatra <no-reply@cynatra.local>

# Web container: the gateway URL as the browser sees it (baked in at build time),
# and the host port for the site.
# PUBLIC_API_URL=http://localhost:4000
# WEB_PORT=3000
