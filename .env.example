# Used by docker-compose. Get a key at https://www.themoviedb.org/settings/api
# (either the v3 API key or the v4 read access token works).
TMDB_API_KEY=
JWT_SECRET=change-me-to-a-long-random-string
# Optional: "Sign in with Google" OAuth client ID (Google Cloud Console →
# Credentials → OAuth client ID → Web application). Empty hides the button.
GOOGLE_CLIENT_ID=
