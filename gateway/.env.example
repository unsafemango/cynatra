PORT=4000
PICKER_URL=http://localhost:8081
# Leave empty to run without accounts (anonymous spins only).
DATABASE_URL=postgres://cynatra:cynatra@localhost:5432/cynatra
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
# "Sign in with Google": an OAuth 2.0 Web client ID from Google Cloud Console.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Email for sign-up codes. Real delivery (e.g. Brevo): set SMTP_HOST/PORT/USER/PASS.
# Local inbox instead: SMTP_URL=smtp://localhost:1025 with Mailpit (http://localhost:8025).
# None set: codes are printed in this terminal (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_URL=
EMAIL_FROM=Cynatra <no-reply@cynatra.local>
